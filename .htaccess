Options -Indexes
<FilesMatch "(?i)\.(csv|sqlite|sqlite3|db|ini|log|json|md|zip)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:app|storage|tests|scripts|docs|dist|node_modules)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config(?:\.example)?\.php|install\.php)$ - [F,L,NC]
RewriteRule ^$ public/ [R=302,L]
