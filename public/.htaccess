Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On
RewriteRule (^|/)\. - [F,L]

# Também funciona quando o document root já aponta diretamente para public/.
RewriteCond %{THE_REQUEST} "\s/+[^\s?]*public(?:[/?\s])" [NC]
RewriteCond %{REQUEST_URI} ^(.*/)?public/(print|offline)\.html$ [NC]
RewriteRule ^ %1%2 [R=302,L]

RewriteCond %{THE_REQUEST} "\s/+[^\s?]*public(?:[/?\s])" [NC]
RewriteCond %{REQUEST_URI} ^(.*/)?public(?:/(.*))?$ [NC]
RewriteRule ^ %1%2 [R=307,L]

RewriteCond %{THE_REQUEST} "\s/+[^\s?]+\.html(?:[?\s])" [NC]
RewriteCond %{REQUEST_URI} ^(.+)\.html$ [NC]
RewriteRule ^(?:print|offline)\.html$ %1 [R=302,L]

RewriteCond %{THE_REQUEST} "\s/+[^\s?]*index\.php(?:[?\s])" [NC]
RewriteCond %{REQUEST_URI} ^(.*/)index\.php$ [NC]
RewriteRule ^index\.php$ %1 [R=302,L]

RewriteCond %{REQUEST_URI} ^(.*/(?:print|offline))/$ [NC]
RewriteRule ^(?:print|offline)/$ %1 [R=302,L]
RewriteRule ^print$ print.html [END]
RewriteRule ^offline$ offline.html [END]
AddType text/javascript .mjs .js
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
<FilesMatch "\.(?:php|html)$">
<IfModule mod_headers.c>
Header always set Cache-Control "no-store, private"
</IfModule>
</FilesMatch>
<FilesMatch "\.(?:mjs|js|css)$">
<IfModule mod_headers.c>
Header always set Cache-Control "no-cache"
</IfModule>
</FilesMatch>
